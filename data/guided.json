,
  {
    "id": 3,
    "title": "1-Bromopropano",
    "subtitle": "Cadeia propil, o sexteto e o efeito do bromo",
    "formula": "C₃H₇Br",
    "chain": [
      { "label": "CH₃" },
      { "label": "CH₂" },
      { "label": "CH₂" },
      { "label": "Br", "fixed": true }
    ],
    "maxPpm": 5,
    "signals": [
      { "id": "sig1", "ppm": 1.0, "int": 3, "mult": "t", "J": 7, "height": 60 },
      { "id": "sig2", "ppm": 1.9, "int": 2, "mult": "sext", "J": 7, "height": 40 },
      { "id": "sig3", "ppm": 3.4, "int": 2, "mult": "t", "J": 7, "height": 40 }
    ],
    "steps": [
      {
        "type": "observe",
        "highlight": [],
        "text": "Fórmula C₃H₇Br → GI = 0: cadeia aberta, sem anel nem C=O. Tudo será padrão de acoplamento simples. O bromo, eletronegativo, desblinda os prótons vizinhos — espere o CH₂ ligado a ele bem à esquerda do espectro."
      },
      {
        "type": "question",
        "highlight": ["sig3"],
        "question": "O tripleto em 3.4 ppm integra 2H. Por que tão desblindado?",
        "options": [
          { "text": "É um CH₂ ligado diretamente ao Br.", "correct": true, "feedback": "Halogênios puxam densidade eletrônica; CH₂–Br aparece em ~3.4. O tripleto mostra que ele vizinha outro CH₂." },
          { "text": "É um CH₃ terminal.", "correct": false, "feedback": "CH₃ integraria 3H e, na ponta da cadeia, seria tripleto em ~1.0, não 3.4." },
          { "text": "É um OH trocável.", "correct": false, "feedback": "OH seria singleto largo e variável; aqui temos tripleto nítido de 2H." }
        ]
      },
      {
        "type": "question",
        "highlight": ["sig1", "sig2"],
        "question": "1.0 (t, 3H) + 1.9 (sexteto, 2H). O que o sexteto revela?",
        "options": [
          { "text": "Um CH₂ central com 5 vizinhos (CH₃ + CH₂).", "correct": true, "feedback": "5 vizinhos → n+1 = 6 picos. É o CH₂ do meio da cadeia propil." },
          { "text": "Um CH com 6 vizinhos.", "correct": false, "feedback": "CH com 6 vizinhos daria septeto de 1H; aqui o sexteto integra 2H." },
          { "text": "Dois CH₃ equivalentes.", "correct": false, "feedback": "Dois CH₃ equivalentes dariam dupleto 6H (padrão isopropil), não sexteto 2H." }
        ]
      },
      {
        "type": "observe",
        "highlight": ["sig1", "sig2", "sig3"],
        "text": "Montagem: CH₃–CH₂–CH₂–Br. Repare no padrão em \"escada\": quanto mais perto do Br, mais desblindado. O sexteto é a assinatura do CH₂ central espremido entre dois grupos."
      }
    ],
    "smiles": "CCCBr"
  },
  {
    "id": 4,
    "title": "Ibuprofeno",
    "subtitle": "Para-substituição, isobutila e o fragmento ácido",
    "formula": "C₁₃H₁₈O₂",
    "chain": [
      { "label": "COOH" },
      { "label": "CH", "branches": [ { "label": "CH₃" } ] },
      { "label": "CH₂" },
      { "label": "CH" },
      { "label": "Anel (Ar)", "fixed": true, "branches": [
        { "label": "H-Ar" },
        { "label": "H-Ar" }
      ] },
      { "label": "CH₃ (isobutila)" }
    ],
    "maxPpm": 12.5,
    "signals": [
      { "id": "sig1", "ppm": 12.0, "int": 1, "mult": "s (largo)", "height": 20 },
      { "id": "sig2", "ppm": 3.7, "int": 1, "mult": "q", "J": 7, "height": 20 },
      { "id": "sig3", "ppm": 2.5, "int": 2, "mult": "d", "J": 7, "height": 40 },
      { "id": "sig4", "ppm": 1.9, "int": 1, "mult": "m", "height": 20 },
      { "id": "sig5", "ppm": 7.2, "int": 2, "mult": "d", "J": 8, "height": 40 },
      { "id": "sig6", "ppm": 7.1, "int": 2, "mult": "d", "J": 8, "height": 40 },
      { "id": "sig7", "ppm": 0.9, "int": 6, "mult": "d", "J": 7, "height": 120 },
      { "id": "sig8", "ppm": 1.5, "int": 3, "mult": "d", "J": 7, "height": 70 }
    ],
    "steps": [
      {
        "type": "observe",
        "highlight": [],
        "text": "C₁₃H₁₈O₂ → GI = (2×13 + 2 − 18) / 2 = <strong>5</strong>. Quatro insaturações sugerem anel benzênico; a quinta, um C=O. Com 18H, espere vários grupos alifáticos."
      },
      {
        "type": "question",
        "highlight": ["sig5", "sig6"],
        "question": "Dois dupletos de 2H em 7.2 e 7.1. Qual o padrão do anel?",
        "options": [
          { "text": "Para-dissubstituído.", "correct": true, "feedback": "2d × 2H é a assinatura de anel para: os quatro H formam dois pares equivalentes." },
          { "text": "Monossubstituído.", "correct": false, "feedback": "Seriam 5H em multipletos, não 2 dupletos limpos de 2H." },
          { "text": "Orto-dissubstituído.", "correct": false, "feedback": "Orto daria 4 sinais 1H distintos (dd, t, t, d)." }
        ]
      },
      {
        "type": "question",
        "highlight": ["sig7", "sig4"],
        "question": "0.9 (d, 6H) + 1.9 (m, 1H). Que fragmento é esse?",
        "options": [
          { "text": "(CH₃)₂CH–CH₂– (isobutila).", "correct": true, "feedback": "Dupleto 6H + multipleto 1H é o par isopropil; o CH₂ a mais completa a isobutila." },
          { "text": "Dois CH₃ isolados.", "correct": false, "feedback": "CH₃ isolados seriam singletos; o dupleto mostra que vizinham um CH." },
          { "text": "CH₂–CH₃ (etila).", "correct": false, "feedback": "Etila é tripleto + quarteto, não dupleto 6H." }
        ]
      },
      {
        "type": "question",
        "highlight": ["sig1", "sig2", "sig8"],
        "question": "12.0 (largo, 1H), 3.7 (q, 1H) e 1.5 (d, 3H). O que fecham juntos?",
        "options": [
          { "text": "–CH(CH₃)–COOH: o q e o d se acoplam entre si e o largo é COOH.", "correct": true, "feedback": "q 1H + d 3H = CH acoplado a CH₃; 12.0 = COOH. Fragmento ácido 2-arilpropanoico, clássico dos AINEs." },
          { "text": "Um éster etílico.", "correct": false, "feedback": "Éster etil seria q 2H + t 3H em ~4.1/1.2; e não explicaria o 12.0." },
          { "text": "Um OH alcoólico + CH₃ de cetona.", "correct": false, "feedback": "OH alcoólico não chega a 12 ppm; e o q/d mostram acoplamento CH–CH₃, não singletos." }
        ]
      },
      {
        "type": "observe",
        "highlight": ["sig1", "sig2", "sig3", "sig4", "sig5", "sig6", "sig7", "sig8"],
        "text": "Montagem final: anel para + isobutila de um lado e –CH(CH₃)COOH do outro = <strong>ibuprofeno</strong>. Todos os 18H atribuídos: 4 (anel) + 9 (isobutila) + 4 (fragmento ácido) + 1 (COOH) = 18."
      }
    ],
    "smiles": "CC(C)Cc1ccc(cc1)C(C)C(=O)O"
  }

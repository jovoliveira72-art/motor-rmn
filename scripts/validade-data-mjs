// scripts/validate-data.mjs
// Uso: node scripts/validate-data.mjs
// Checa: JSON válido, vírgula decimal em texto, integridade de referências
// (correctTarget → signals), atomIndices dentro do range do SMILES,
// exatamente 1 alternativa correta por pergunta.

import { readFileSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { join, dirname } from 'node:path';

const dataDir = join(dirname(fileURLToPath(import.meta.url)), '..', 'data');
let fail = 0;
const err = m => { fail++; console.error('✗', m); };
const ok = m => console.log('✓', m);

function countAtoms(smiles) {
  let n = 0;
  for (let i = 0; i < smiles.length; i++) {
    const ch = smiles[i], next = smiles[i + 1] || '';
    if (ch === '[') { n++; i = smiles.indexOf(']', i); continue; }
    if (ch === 'C' && (next === 'l' || next === 'r')) { n++; i++; continue; }
    if ('BCNOPSFIbcnops'.includes(ch)) n++;
  }
  return n;
}

const files = readdirSync(dataDir).filter(f => f.endsWith('.json'));

for (const f of files) {
  const raw = readFileSync(join(dataDir, f), 'utf8');
  let data;
  try { data = JSON.parse(raw); }
  catch (e) { err(`${f}: JSON inválido — ${e.message}`); continue; }
  ok(`${f}: JSON válido`);

  const badStrings = (raw.match(/"[^"]*"/g) || []).filter(s => /\d\.\d/.test(s));
  if (badStrings.length) err(`${f}: ponto decimal em texto: ${badStrings.slice(0, 3).join(' | ')}`);

  const arr = Array.isArray(data) ? data : Object.values(data);

  for (const item of arr) {
    const label = `${f} #${item.level ?? item.id ?? '?'}`;

    // exatamente 1 correta em options (solo/guided-steps/blocks-quiz)
    const optSets = [];
    if (Array.isArray(item.options)) optSets.push(item.options);
    if (Array.isArray(item.steps)) optSets.push(...item.steps.filter(s => s.options).map(s => s.options));
    if (Array.isArray(item)) item.filter(b => b?.options).forEach(b => optSets.push(b.options));
    for (const opts of optSets) {
      const n = opts.filter(o => o.correct).length;
      if (n !== 1) err(`${label}: pergunta com ${n} corretas (esperado 1)`);
    }

    // highlight ⊆ signals
    const sigIds = new Set([
      ...(item.signals || []).map(s => s.id),
      ...(item.signals13C || []).map(s => s.id),
      ...(item.spectra?.['1H']?.signals || []).map(s => s.id)
    ]);
    const highlights = [];
    if (item.highlight) highlights.push(item.highlight);
    if (Array.isArray(item.steps)) item.steps.forEach(s => s.highlight && highlights.push(s.highlight));
    for (const hl of highlights)
      for (const id of hl) if (!sigIds.has(id)) err(`${label}: highlight "${id}" não existe em signals`);

    // correctTarget → signals; atomIndices < nº de átomos
    const chains = [...(item.chain || []), ...(item.chain13C || [])];
    const flat = [];
    chains.forEach(c => { if (c.tagId) flat.push(c); (c.branches || []).forEach(b => b.tagId && flat.push(b)); });
    const nAtoms = item.smiles ? countAtoms(item.smiles) : null;
    for (const t of flat) {
      if (t.correctTarget && !sigIds.has(t.correctTarget))
        err(`${label}: correctTarget "${t.correctTarget}" não existe`);
      if (nAtoms && (t.atomIndices || []).some(i => i >= nAtoms))
        err(`${label}: atomIndices fora do range (${nAtoms} átomos em "${item.smiles}")`);
    }
  }
}

// tutorial.json: 12 níveis únicos; blocks.json: mesmas chaves
const tut = JSON.parse(readFileSync(join(dataDir, 'tutorial.json'), 'utf8'));
const levels = tut.map(t => t.level);
if (levels.length !== 12 || new Set(levels).size !== 12) err('tutorial.json: esperado 12 níveis únicos');
else ok('tutorial.json: 12 níveis únicos');

try {
  const blocks = JSON.parse(readFileSync(join(dataDir, 'blocks.json'), 'utf8'));
  const keys = Object.keys(blocks).map(Number).sort((a, b) => a - b);
  const missing = levels.filter(l => !keys.includes(l));
  if (missing.length) err(`blocks.json: sem blocos para níveis ${missing.join(', ')}`);
  else ok('blocks.json: cobre os 12 níveis');
  const kinds = ['fala', 'texto', 'diagrama', 'exemplo', 'tabela', 'checklist', 'quiz'];
  const diagrams = ['ppm-axis', 'splitting-tree', 'c13-axis', 'd2o', 'dept', 'shield'];
  for (const [lvl, arr] of Object.entries(blocks))
    for (const b of arr) {
      if (!kinds.includes(b.type)) err(`blocks ${lvl}: tipo desconhecido "${b.type}"`);
      if (b.type === 'diagrama' && !diagrams.includes(b.kind)) err(`blocks ${lvl}: diagrama "${b.kind}" não implementado`);
    }
} catch { err('blocks.json: não carregou'); }

console.log(fail ? `\n${fail} problema(s).` : '\nTudo limpo.');
process.exit(fail ? 1 : 0);
